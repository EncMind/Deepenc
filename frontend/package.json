{
  "name": "deepenc",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:local": "ng serve --proxy-config proxy.conf.local.js --configuration local --host 0.0.0.0 --port 4200 --live-reload --hmr",
    "serve:local": "ng serve --proxy-config proxy.conf.local.js --configuration local --open",
    "build": "ng build",
    "build:local": "ng build --configuration local --watch",
    "build:prod": "ng build --configuration production",
    "debug": "ng serve --proxy-config proxy.conf.local.js --configuration local --source-map --verbose --open"
  },
  "dependencies": {
    "@angular/animations": "20.1.6",
    "@angular/common": "20.1.6",
    "@angular/compiler": "20.1.6",
    "@angular/core": "20.1.6",
    "@angular/forms": "20.1.6",
    "@angular/platform-browser": "20.1.6",
    "@angular/platform-browser-dynamic": "20.1.6",
    "@angular/router": "20.1.6",
    "@stripe/stripe-js": "^2.1.0",
    "chart.js": "^4.4.0",
    "firebase": "^10.7.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "marked": "^16.3.0",
    "mermaid": "^11.12.0",
    "ng2-charts": "^5.0.0",
    "ngx-markdown": "^20.1.0",
    "prismjs": "^1.30.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "7.8.1",
    "tslib": "2.6.2",
    "yargs": "^18.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.6",
    "@angular/cli": "^20.1.6",
    "@angular/compiler-cli": "20.1.6",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
